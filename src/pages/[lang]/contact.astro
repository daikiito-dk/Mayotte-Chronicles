---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publicLangs, type PublicLang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../config/site';

export const getStaticPaths = (() => publicLangs.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as PublicLang;
const t = useTranslations(lang);
const formId = site.tallyForms[lang];
const embedUrl = `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1`;
const directUrl = `https://tally.so/r/${formId}`;
---

<BaseLayout lang={lang} title={t['contact.title']} description={t['contact.intro']}>
  <div class="narrow page">
    <h1>{t['contact.title']}</h1>
    <p>{t['contact.intro']}</p>
    <iframe src={embedUrl} title={t['contact.frameTitle']} loading="lazy" width="100%" height="900"></iframe>
    <p><a href={directUrl} target="_blank" rel="noopener">{t['contact.open']}</a></p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: 3rem;
  }
  iframe {
    display: block;
    width: 100%;
    min-height: 56rem;
    border: 0;
    margin: 1.5rem 0;
  }
</style>
