---
import { languages, publicLangs, defaultLang } from '../i18n/config';
import { absolute, path } from '../lib/urls';
import { site } from '../config/site';
import { ui } from '../i18n/ui';

const base = path();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="description" content={ui.en['site.tagline']} />
    <link rel="icon" href={path('favicon.svg').replace(/\/$/, '')} type="image/svg+xml" />
    {publicLangs.map((l) => <link rel="alternate" hreflang={l} href={absolute(path(l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(path(defaultLang), Astro.site)} />
    <script is:inline define:vars={{ langs: publicLangs, base, fallback: defaultLang }}>
      // Pick the first browser language we publish in; otherwise English (SPEC 3.2).
      var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
      var target = fallback;
      for (var i = 0; i < prefs.length; i++) {
        var code = String(prefs[i]).toLowerCase().split('-')[0];
        if (langs.indexOf(code) !== -1) {
          target = code;
          break;
        }
      }
      location.replace(base + target + '/');
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #faf6ee;
        color: #1f2a2e;
        font-family: system-ui, -apple-system, 'Hiragino Sans', 'Noto Sans JP', sans-serif;
      }
      main {
        text-align: center;
        padding: 2rem;
      }
      h1 {
        font-family: Georgia, 'Hiragino Mincho ProN', serif;
        color: #0b5f63;
      }
      ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
      }
      a {
        color: #0b5f63;
        font-size: 1.1rem;
      }
      .soon {
        color: #52615f;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{site.name}</h1>
      <ul>
        {
          languages.map((l) =>
            l.status === 'public' ? (
              <li>
                <a href={path(l.code)} hreflang={l.code} lang={l.code}>
                  {l.name}
                </a>
              </li>
            ) : (
              <li class="soon" lang={l.code}>
                {l.name} <small lang="en">(Coming soon)</small>
              </li>
            ),
          )
        }
      </ul>
    </main>
  </body>
</html>
