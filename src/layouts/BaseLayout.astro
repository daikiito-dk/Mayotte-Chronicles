---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { publicLangs, defaultLang, type PublicLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { absolute, filePath, path } from '../lib/urls';
import { site } from '../config/site';
import placeholder from '../../content/images/placeholder.jpg';

type Alternates = Partial<Record<PublicLang, string>>;

interface Props {
  lang: PublicLang;
  title?: string;
  description?: string;
  /** Language versions of this page. Defaults to the same path in every public language. */
  alternates?: Alternates;
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, title, description, ogImage, ogType = 'website', noindex = false } = Astro.props;
const t = useTranslations(lang);

const prefix = path(lang);
const rest = Astro.url.pathname.startsWith(prefix) ? Astro.url.pathname.slice(prefix.length) : '';
const alternates: Alternates =
  Astro.props.alternates ?? Object.fromEntries(publicLangs.map((l) => [l, path(l, rest)]));

const fullTitle = title ? `${title} | ${site.name}` : site.name;
const metaDescription = description ?? t['site.tagline'];
const canonical = absolute(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogImage ?? placeholder, width: 1200, height: 630, format: 'jpg' });
const ogUrl = absolute(og.src, Astro.site);
const ogLocales: Record<PublicLang, string> = { ja: 'ja_JP', fr: 'fr_FR', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        Object.entries(alternates).map(([l, href]) => (
          <link rel="alternate" hreflang={l} href={absolute(href!, Astro.site)} />
        ))
    }
    {!noindex && alternates[defaultLang] && <link rel="alternate" hreflang="x-default" href={absolute(alternates[defaultLang]!, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} (${lang})`} href={filePath(lang, 'rss.xml')} />
    <link rel="icon" href={path('favicon.svg').replace(/\/$/, '')} type="image/svg+xml" />
    <meta name="theme-color" content="#0b5f63" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
